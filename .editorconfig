# EditorConfig for TWC Mission Server
# Enforces UTF-8 with BOM and CRLF line endings for all .cs files
# https://editorconfig.org

root = true

[*.cs]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{md,txt,ps1,json,xml,csproj,sln}]
end_of_line = crlf
insert_final_newline = true