public class ConsoleInterceptor : TextWriter
{
    private readonly TextWriter _originalOutput;
    private readonly StringBuilder _lineBuffer = new StringBuilder();
	private Mission mainmission;
	private ThreadLoadMission threadloadmission;
    
    public event System.Action<string> OnLineWritten;

    public ConsoleInterceptor(TextWriter originalOutput, Mission msn, ThreadLoadMission tlmsn)
    {
        _originalOutput = originalOutput;
		mainmission = msn;
		threadloadmission = tlmsn;
    }

    public override Encoding Encoding
    {
        get { return _originalOutput.Encoding; }
    }

    // Intercepting single characters is the most reliable way 
    // to catch everything from Console.Write and Console.WriteLine
    public override void Write(char value)
    {
        _originalOutput.Write(value);

        if (value == '\n')
        {
            string completedLine = _lineBuffer.ToString().TrimEnd('\r');
            _lineBuffer.Clear();

			if (completedLine.Contains("Server got logged out of Steam") || completedLine.Contains("Got logged out of Steam") || completedLine.Contains("connection to Steam lost"))
			{
				// 4. EMERGENCY BRAKE: Force the game's thread to run your cleanup synchronously!
				threadloadmission.OnUnhandledException(sender: "Steam Shutdown (TWC)", st: "Steam Shutting Down! (maddox.steam.WClient OnSteamShutdown triggered)");	
			}
			else
			{
				// Normal message, pass to your async queue as usual
				//if (OnLineWritten != null) OnLineWritten(completedLine);
			}
		}		
        else
        {
            _lineBuffer.Append(value);
        }
    }

    // Overriding the buffer array ensures high-performance string writes match perfectly
    public override void Write(char[] buffer, int index, int count)
    {
        _originalOutput.Write(buffer, index, count);
        
        for (int i = index; i < index + count; i++)
        {
            char value = buffer[i];
            if (value == '\n')
            {
                string completedLine = _lineBuffer.ToString().TrimEnd('\r');
                _lineBuffer.Clear();

                if (OnLineWritten != null)
                {
                    OnLineWritten(completedLine);
                }
            }
            else
            {
                _lineBuffer.Append(value);
            }
        }
    }
}

public class AsyncConsoleProcessor : IDisposable
{
    // Thread-safe queue for staging logs
    private readonly BlockingCollection<string> _msgQueue = new BlockingCollection<string>();
    private readonly Task _workerTask;
	Mission mainmission;
	ThreadLoadMission threadloadmission;

    public AsyncConsoleProcessor(Mission msn, ThreadLoadMission tlmsn)
    {
		mainmission = msn;
		threadloadmission = tlmsn;
        // Start a dedicated background thread to process messages
        _workerTask = Task.Factory.StartNew(ProcessQueue, TaskCreationOptions.LongRunning);
    }

    // This method intercepts Console messages from the event
    public void EnqueueMessage(string message)
    {
        _msgQueue.Add(message);
    }

    private void ProcessQueue()
    {
        // GetConsumingEnumerable blocks the thread automatically when empty, 
        // consuming 0% CPU until a new message arrives.
        foreach (string message in _msgQueue.GetConsumingEnumerable())
        {
            // Execute your heavy background tasks safely here
            // e.g., writing to a file, database, or sending network requests.
            //System.Diagnostics.Debug.WriteLine("[ASYNC WORKER THREAD]: " + message);
			//File.AppendAllText(mainmission.CLOD_PATH + mainmission.FILE_PATH + "/launchercrashes/shadow-console.log", message + "\n");
			if (message.Contains("Server got logged out of Steam") || message.Contains("Got logged out of Steam") || message.Contains("connection to Steam lost")){
				// 1. Force write out simple urgent telemetry file immediately - file date will show last crash if all else fails
				System.IO.File.WriteAllText(mainmission.CLOD_PATH + mainmission.FILE_PATH + "/launchercrashes/launcher-steam-connection-died-semaphore.log", "1");
				
				//double timeSinceLastOnSteamShutdown_s = DateTime.Now.Subtract(lastOnSteamShutdown).TotalSeconds;
				//lastOnSteamShutdown = DateTime.Now;
				
				// 2. Log the issue more precisely; usually the log file is still working on a Steam disconnection so we'll see it
				Console.WriteLine("[FMB INTERCEPT] WClient.onSteamShutdown triggered at {0:u}! Running emergency triage, save, etc ...", DateTime.Now);
				
				//So steam shutdown notices seem to come fast & furious for a second or two before final disconnect
				//So we could wait until say 2 notices before slamming the shutdown, but let's not.
				//if (timeSinceLastOnSteamShutdown_s > 0.5 && timeSinceLastOnSteamShutdown_s < 30) {
				//}
				
				
				// 3. Handle the issue more extensively, save needed files, softExit people rather than killing etc
				threadloadmission.OnUnhandledException(sender: "Steam Shutdown (TWC)", st: "Steam Shutting Down! (maddox.steam.WClient OnSteamShutdown triggered)");	
			}
        }
    }

    public void Dispose()
    {
        // Tell the collection no more items are coming
        _msgQueue.CompleteAdding();
        
        // Wait for the background thread to finish processing remaining logs
        _workerTask.Wait();
        _msgQueue.Dispose();
    }
}