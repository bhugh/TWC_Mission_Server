<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core project settings -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net482</TargetFramework>
    <RootNamespace>TWC_Mission_Server</RootNamespace>
    <AssemblyName>TWC_Mission_Server</AssemblyName>

    <!-- Required for C# Dev Kit to honor explicit System.* references -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>

    <!-- Allow pointer usage -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Build configurations -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Game install path -->
  <PropertyGroup>
    <CloDInstallPath>
      C:\Program Files (x86)\Steam\steamapps\common\IL-2 Sturmovik Cliffs of Dover Blitz\parts\core\
    </CloDInstallPath>
  </PropertyGroup>

  <!-- Explicit .NET Framework references (required when implicit refs are disabled) -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <!-- Managed engine assemblies ONLY -->
  <ItemGroup>
    <Reference Include="Strategy">
      <HintPath>$(CloDInstallPath)Strategy.dll</HintPath>
    </Reference>
    <Reference Include="gamePlay">
      <HintPath>$(CloDInstallPath)gamePlay.dll</HintPath>
    </Reference>
    <Reference Include="gamePages">
      <HintPath>$(CloDInstallPath)gamePages.dll</HintPath>
    </Reference>
    <Reference Include="CloDMissionCommunicator">
      <HintPath>$(CloDInstallPath)CloDMissionCommunicator.dll</HintPath>
    </Reference>
    <Reference Include="Maddox">
      <HintPath>$(CloDInstallPath)maddox.dll</HintPath>
    </Reference>
    <Reference Include="part">
      <HintPath>$(CloDInstallPath)part.dll</HintPath>
    </Reference>
    <Reference Include="WSteam">
      <HintPath>$(CloDInstallPath)WSteam.dll</HintPath>
    </Reference>
    <Reference Include="GameWorld">
      <HintPath>$(CloDInstallPath)GameWorld.dll</HintPath>
    </Reference>
    <Reference Include="HostView">
      <HintPath>$(CloDInstallPath)HostView.dll</HintPath>
    </Reference>
    <Reference Include="Campaign">
      <HintPath>$(CloDInstallPath)Campaign.dll</HintPath>
    </Reference>
    <Reference Include="core">
      <HintPath>$(CloDInstallPath)core.dll</HintPath>
    </Reference>
    <Reference Include="antlr.runtime">
      <HintPath>$(CloDInstallPath)antlr.runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Native DLLs (must NOT be <Reference> or Roslyn will crash) -->
  <ItemGroup>
    <None Include="$(CloDInstallPath)libeay32.dll" />
    <None Include="$(CloDInstallPath)ssleay32.dll" />
    <None Include="$(CloDInstallPath)SimulBase_MD.dll" />
    <None Include="$(CloDInstallPath)SimulClouds_MD.dll" />
    <None Include="$(CloDInstallPath)SimulCrossPlatform_MD.dll" />
    <None Include="$(CloDInstallPath)SimulDirectX11_MD.dll" />
    <None Include="$(CloDInstallPath)SimulGeometry_MD.dll" />
    <None Include="$(CloDInstallPath)SimulMath_MD.dll" />
    <None Include="$(CloDInstallPath)SimulScene_MD.dll" />
    <None Include="$(CloDInstallPath)SimulSky_MD.dll" />
    <None Include="$(CloDInstallPath)SimulTerrain_MD.dll" />
    <None Include="$(CloDInstallPath)fmod.dll" />
    <None Include="$(CloDInstallPath)fmodstudio.dll" />
    <None Include="$(CloDInstallPath)fmod_event.dll" />
    <None Include="$(CloDInstallPath)fmod_event64.dll" />
    <None Include="$(CloDInstallPath)fmodex.dll" />
    <None Include="$(CloDInstallPath)steam_api.dll" />
    <None Include="$(CloDInstallPath)steam_api64.dll" />
    <None Include="$(CloDInstallPath)ImportASE.dll" />
    <None Include="$(CloDInstallPath)d3dcompiler_47.dll" />
    <None Include="$(CloDInstallPath)dinput8.dll" />
  </ItemGroup>

</Project>
